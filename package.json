{
  "name": "quoteflow-rating-service",
  "version": "0.1.0",
  "private": true,
  "description": "QuoteFlow rating/quoting engine for Acme Insurance — ships its own form config and validator bundles to the browser.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,bundles \"tsx watch src/server.ts\" \"tsx scripts/watch-bundles.ts\"",
    "build": "tsc -p tsconfig.json",
    "build:bundles": "tsx scripts/build-bundles.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "seed": "knex --knexfile knexfile.ts seed:run",
    "prepare": "husky"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.1",
    "express": "^4.19.2",
    "fast-json-patch": "^3.1.1",
    "inversify": "^6.0.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.2.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "chokidar": "^3.6.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
