# Copy to .env and fill in. The server fails fast on startup if any of these are missing.

# Postgres connection string (system of record for carriers/quotes/jobs)
DATABASE_URL=postgres://postgres:quoteflow@localhost:5432/quoteflow_rating

# Redis connection string (session/cache, short TTL)
REDIS_URL=redis://localhost:6379

# RabbitMQ connection string (this service PRODUCES carrier.bind.requested jobs; a worker in
# quoteflow-apps consumes them)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# HTTP port
PORT=4000

# Comma-separated list of allowed browser origins for the CORS-wrapped API router
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
